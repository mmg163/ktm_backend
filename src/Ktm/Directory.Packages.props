<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Версии фиксированные, без плавающих (ADR-0001). -->
    <ItemGroup>
        <!-- Ktm.Api -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />

        <!-- Data Saver admin: только UI-middleware (MIT, встроенные ассеты swagger-ui - Apache-2.0); генерация документа - встроенный Microsoft.AspNetCore.OpenApi, SwaggerGen не нужен -->
        <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />

        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

        <!-- Data Saver -->
        <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />

        <!-- Core: проверка по JSON Schema draft 2020-12 (docs/api/kafka-event.schema.json); MIT, без зависимостей от Kafka/Npgsql/ASP.NET -->
        <PackageVersion Include="LateApexEarlySpeed.Json.Schema" Version="5.0.0" />

        <!-- Core: только абстракции логирования (MIT), единственная допустимая зависимость цикла приёма -->
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />

        <!-- Тесты -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="coverlet.collector" Version="10.1.1" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.1" />
        <!-- Версия 10.0.13 (ниже 10.0.15 у остальных framework-пакетов) выровнена с framework-пакетами, которые тянет за собой тестовый хост -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
        <PackageVersion Include="Testcontainers.Kafka" Version="4.17.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    </ItemGroup>

</Project>
