<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <IsDataSaverProject>true</IsDataSaverProject>
        <!-- XML-комментарии DTO попадают в описание схем OpenAPI (docs/api/data-saver-admin.openapi.json); CS1591 - не все публичные члены сервиса документируются -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Статическая админка /admin/ui/: встроенные ресурсы, без сборки фронтенда -->
        <EmbeddedResource Include="Admin\Ui\**\*" LogicalName="Ktm.DataSaver.Admin.Ui/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ktm.DataSaver.Infrastructure\Ktm.DataSaver.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ktm.Binding.Infrastructure\Ktm.Binding.Infrastructure.csproj" />
        <ProjectReference Include="..\Ktm.Interpretation.Infrastructure\Ktm.Interpretation.Infrastructure.csproj" />
    </ItemGroup>
</Project>
