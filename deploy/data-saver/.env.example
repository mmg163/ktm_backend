# Шаблон переменных окружения Data Saver (ADR-0002, D-11). Реальные значения - только в .env (в git не попадает).
# Секреты (пароль БД, пароль SASL) в .env не кладём: только файлом через ...PasswordFile (Docker secret, см. docker-compose.yml).
# Значения без кавычек: env_file Docker Compose читает кавычки буквально.
# Полное описание переменных - docs/manuals/data-saver.md.

# --- Kafka (обязательна только BootstrapServers) ---
DataSaver__Kafka__BootstrapServers=<kafka-host>:9092
# Для всех источников можно подписаться регулярным выражением: ^ktm\.events\.raw\..+
# (на dev-стенде сейчас ktm.events.raw.skud; режим regex не проверен)
DataSaver__Kafka__Topic=ktm.events.raw
DataSaver__Kafka__RejectedTopic=ktm.events.rejected
DataSaver__Kafka__GroupId=ktm-data-saver
# При нескольких репликах - уникальное значение на каждую (static membership), см. руководство:
# DataSaver__Kafka__GroupInstanceId=data-saver-1
# На dev - PLAINTEXT (ADR-0002 R-3); для SASL: SecurityProtocol, SaslMechanism, SaslUsername и SaslPasswordFile
# DataSaver__Kafka__SecurityProtocol=PLAINTEXT

# --- PostgreSQL (обязательны Host, Database, Username и пароль) ---
DataSaver__Postgres__Host=<db-host>
DataSaver__Postgres__Port=5432
DataSaver__Postgres__Database=<database>
DataSaver__Postgres__Username=ktm_app
# Шифрование канала: Disable, Prefer, Require (по умолчанию), VerifyCA, VerifyFull; Disable - только для локальной разработки
DataSaver__Postgres__SslMode=Require
# Контейнер migrate (разовый накат миграций, ADR-0004 п. 5) использует Host, Port, Database и SslMode отсюда; пользователь всегда
# ktm_migrator, пароль - только файлом secrets/ktm_migrator_password (в .env не кладётся).
# Ожидание блокировки наката другим запуском migrate, секунды (по умолчанию 120):
# MIGRATE_LOCK_TIMEOUT_SECONDS=120
# Пароль - файлом (путь внутри контейнера; secret ktm_app_password из docker-compose.yml). Одновременно с ...__Password не задавать.
DataSaver__Postgres__PasswordFile=/run/secrets/ktm_app_password

# --- Остановка и health (значения по умолчанию, можно не задавать) ---
# stop_grace_period в docker-compose.yml (40s) связан с TimeoutSeconds: не меньше TimeoutSeconds + 5 (host) + запас
# Файл секрета БД: chown 1654:1654 + chmod 0400 (0444 - только альтернатива, если chown невозможен; читаем всем на хосте)
DataSaver__Shutdown__TimeoutSeconds=30
DataSaver__Health__Port=8080
