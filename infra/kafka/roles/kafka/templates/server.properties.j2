# {{ ansible_managed }}
process.roles=broker,controller
node.id={{ kafka_node_id }}
controller.quorum.voters={{ kafka_node_id }}@localhost:{{ kafka_controller_port }}
listeners=PLAINTEXT://:{{ kafka_port }},CONTROLLER://localhost:{{ kafka_controller_port }}
advertised.listeners=PLAINTEXT://{{ kafka_advertised_host }}:{{ kafka_port }}
controller.listener.names=CONTROLLER
inter.broker.listener.name=PLAINTEXT
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
log.dirs={{ kafka_data_dir }}
num.partitions={{ kafka_default_partitions }}
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
share.coordinator.state.topic.replication.factor=1
share.coordinator.state.topic.min.isr=1
log.retention.hours={{ kafka_log_retention_hours }}
auto.create.topics.enable={{ kafka_auto_create_topics | lower }}
